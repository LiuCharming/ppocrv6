# 可选：不设置或留空时无需鉴权；需要鉴权时取消下一行注释并填写密钥
# MODEL_API_KEY=your-model-key
GPU_ID=0
MODEL_SIZE=medium
MODEL_PORT=8001
MODEL_BIND=0.0.0.0
MAX_IMAGE_MB=10
MAX_IMAGE_PIXELS=25000000
# 同一实例中同时推理的模型副本数；GPU 显存不足则调小到 1
OCR_CONCURRENCY=2
# 等待推理的请求数；队列满时接口返回 503
OCR_QUEUE_SIZE=16
# Docker 三模型部署时每个模型容器的等待队列长度
MODEL_QUEUE_SIZE=1
MODEL_TIMEOUT_SECONDS=120

# 国内源；已有 .env 也可追加以下配置
BASE_IMAGE=m.daocloud.io/docker.io/library/python:3.11-slim-bookworm
APT_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian
APT_SECURITY_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian-security
PIP_INDEX_URL=https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple
PADDLE_VERSION=3.2.0
PADDLE_INDEX_URL=https://www.paddlepaddle.org.cn/packages/stable/cu118/
PADDLE_PDX_MODEL_SOURCE=BOS

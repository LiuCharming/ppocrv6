ARG BASE_IMAGE=m.daocloud.io/docker.io/library/python:3.11-slim-bookworm
FROM ${BASE_IMAGE}
ARG PIP_INDEX_URL=https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_INDEX_URL=${PIP_INDEX_URL} PIP_DEFAULT_TIMEOUT=120
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY common common
COPY router_service router_service
USER 10001:10001
EXPOSE 8000
CMD ["uvicorn", "router_service.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
